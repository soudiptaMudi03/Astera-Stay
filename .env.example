# Copy this file to .env and fill in real values. Never commit the real .env file.

# MongoDB Atlas connection string. Get this from Atlas -> Database -> Connect -> Drivers.
# Format: mongodb+srv://<user>:<password>@<cluster-url>/<dbname>?retryWrites=true&w=majority
ATLAS_URL=

# Any long random string, used to sign session cookies and encrypt the session store.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SECRET=

# Cloudinary credentials, from the Cloudinary dashboard (cloudinary.com/console)
CLOUD_NAME=
CLOUD_API_KEY=
CLOUD_API_SECRET=

# MapTiler API key, from cloud.maptiler.com/account/keys
# IMPORTANT: the key previously hardcoded in controller/listing.js is committed to this repo's
# git history and must be treated as leaked. Generate a NEW key and put it here.
MAP_TOKEN=

# Optional. Defaults to 8080 locally; hosting platforms like Render set this automatically.
PORT=8080

# Optional. Only used by inits/initData.js to attach a specific user as the owner of seed listings.
SEED_OWNER_ID=
